generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String              @id @default(uuid())
  email          String              @unique
  name           String?
  passwordHash   String?
  role           UserRole            @default(STUDENT)
  onboarded      Boolean             @default(false)
  xp             Int                 @default(0)
  streakCount    Int                 @default(0)
  lastActiveAt   DateTime?           @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attempts       AssessmentAttempt[]
  auditLogs      AuditLog[]
  bookmarks      Bookmark[]
  chatSessions   ChatSession[]
  issuedCerts    Credential[]        @relation("IssuedCredentials")
  credentials    Credential[]        @relation("EarnedCredentials")
  enrollments    Enrollment[]
  examSessions   ExamSession[]
  facultyInfo    FacultyMember?
  instAdminInfo  InstitutionAdmin?
  notes          Note[]
  notifications  Notification[]
  progresses     Progress[]
  uploads        Upload[]
  violations     ViolationLog[]
  xpTransactions XpTransaction[]

  @@map("users")
}

model Institution {
  id                  String               @id @default(uuid())
  name                String
  logoUrl             String?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  city                String?
  country             String?
  state               String?
  credentialTemplates CredentialTemplate[]
  credentials         Credential[]
  faculty             FacultyMember[]
  admins              InstitutionAdmin[]
  programs            Program[]
  questionBanks       QuestionBank[]

  @@map("institutions")
}

model InstitutionAdmin {
  id            String      @id @default(uuid())
  userId        String      @unique
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("institution_admins")
}

model FacultyMember {
  id                 String                    @id @default(uuid())
  userId             String                    @unique
  institutionId      String
  department         String?
  designation        String?
  verificationStatus FacultyVerificationStatus @default(PENDING)
  institution        Institution               @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programs           Program[]
  questionBanks      QuestionBank[]

  @@map("faculty_members")
}

model Program {
  id            String         @id @default(uuid())
  title         String
  description   String
  category      ProgramCategory @default(AI)
  tier          ProgramTier     @default(TIER_1)
  institutionId String
  facultyId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chatSessions  ChatSession[]
  credentials   Credential[]
  enrollments   Enrollment[]
  tracks        ProgramTrack[]
  faculty       FacultyMember? @relation(fields: [facultyId], references: [id])
  institution   Institution    @relation(fields: [institutionId], references: [id])

  @@map("programs")
}

model ProgramTrack {
  id          String    @id @default(uuid())
  programId   String
  type        TrackType
  title       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  modules     Module[]
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_tracks")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  programId   String
  createdAt   DateTime  @default(now())
  progress    Int       @default(0)
  completedAt DateTime?
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@map("enrollments")
}

model Module {
  id           String        @id @default(uuid())
  trackId      String
  title        String
  order        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assessments  Assessment[]
  chatSessions ChatSession[]
  lessons      Lesson[]
  track        ProgramTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Lesson {
  id           String        @id @default(uuid())
  moduleId     String
  title        String
  content      String
  videoUrl     String?
  order        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookmarks    Bookmark[]
  chatSessions ChatSession[]
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes        Note[]
  progresses   Progress[]

  @@map("lessons")
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progresses")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("bookmarks")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  content   String
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("notes")
}

model QuestionBank {
  id            String                 @id @default(uuid())
  title         String
  description   String?
  institutionId String
  facultyId     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  assessments   Assessment[]
  questions     QuestionBankQuestion[]
  faculty       FacultyMember?         @relation(fields: [facultyId], references: [id])
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("question_banks")
}

model QuestionBankQuestion {
  id             String           @id @default(uuid())
  questionBankId String
  text           String
  category       String?
  timerSeconds   Int              @default(60)
  createdAt      DateTime         @default(now())
  difficulty     Difficulty       @default(MEDIUM)
  tags           String[]         @default([])
  attemptAnswers AttemptAnswer[]
  questionBank   QuestionBank     @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  options        QuestionOption[]

  @@map("question_bank_questions")
}

model QuestionOption {
  id             String               @id @default(uuid())
  questionId     String
  text           String
  isCorrect      Boolean              @default(false)
  attemptAnswers AttemptAnswer[]
  question       QuestionBankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Assessment {
  id             String              @id @default(uuid())
  moduleId       String
  questionBankId String
  title          String
  passingScore   Int                 @default(80)
  sampleSize     Int                 @default(15)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  timeLimit      Int                 @default(1800)
  attempts       AssessmentAttempt[]
  module         Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank        @relation(fields: [questionBankId], references: [id])
  examSessions   ExamSession[]

  @@map("assessments")
}

model AssessmentAttempt {
  id             String          @id @default(uuid())
  userId         String
  assessmentId   String
  score          Int             @default(0)
  passed         Boolean         @default(false)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]
  violations     ViolationLog[]

  @@map("assessment_attempts")
}

model AttemptAnswer {
  id               String               @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean              @default(false)
  answeredAt       DateTime             @default(now())
  attempt          AssessmentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuestionBankQuestion @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption       @relation(fields: [selectedOptionId], references: [id])

  @@map("attempt_answers")
}

model ViolationLog {
  id        String             @id @default(uuid())
  attemptId String?
  userId    String
  type      ViolationType
  loggedAt  DateTime           @default(now())
  sessionId String?
  attempt   AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  session   ExamSession?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("violation_logs")
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  type      XpType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_transactions")
}

model Credential {
  id                   String              @id @default(uuid())
  userId               String
  programId            String
  institutionId        String
  issuedById           String
  tier                 CredentialTier
  verificationCode     String              @unique
  verificationUrl      String
  verificationStatus   VerifyStatus        @default(ACTIVE)
  metadata             String?
  issuedAt             DateTime            @default(now())
  credentialTemplateId String?
  credentialTemplate   CredentialTemplate? @relation(fields: [credentialTemplateId], references: [id])
  institution          Institution         @relation(fields: [institutionId], references: [id])
  issuer               User                @relation("IssuedCredentials", fields: [issuedById], references: [id])
  program              Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  user                 User                @relation("EarnedCredentials", fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Upload {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  fileType   String
  fileUrl    String
  sizeBytes  Int
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("uploads")
}

model ChatSession {
  id              String        @id @default(uuid())
  userId          String
  activeProgramId String?
  activeModuleId  String?
  activeLessonId  String?
  createdAt       DateTime      @default(now())
  messages        ChatMessage[]
  lesson          Lesson?       @relation(fields: [activeLessonId], references: [id])
  module          Module?       @relation(fields: [activeModuleId], references: [id])
  program         Program?      @relation(fields: [activeProgramId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  sender    ChatSender
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  archived  Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  details   String?
  ipAddress String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ExamSession {
  id             String         @id @default(uuid())
  userId         String
  assessmentId   String
  status         ExamStatus     @default(ACTIVE)
  warningsCount  Int            @default(0)
  scoreDeduction Int            @default(0)
  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  lockoutUntil   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  questionSet    Json?
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  violations     ViolationLog[]

  @@map("exam_sessions")
}

model CredentialTemplate {
  id            String         @id @default(uuid())
  name          String
  type          CredentialType
  institutionId String
  designUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  credentials   Credential[]

  @@map("credential_templates")
}

enum UserRole {
  STUDENT
  FACULTY
  UNIVERSITY_ADMIN
  DEZAI_ADMIN
}

enum FacultyVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrackType {
  ROOTS
  EDGE
}

enum ProgramCategory {
  AI
  COMMERCE
  DESIGN
}

enum ProgramTier {
  TIER_1
  TIER_2
  TIER_3
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ViolationType {
  TAB_SWITCH
  COPY_PASTE
  FOCUS_LOSS
}

enum XpType {
  DAILY_STREAK
  MODULE_COMPLETION
  ASSESSMENT_PASS
}

enum CredentialTier {
  FORGE
  ARENA
  CITADEL
}

enum VerifyStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

enum ChatSender {
  USER
  MENTOR
}

enum NotificationType {
  REMINDER
  CREDENTIAL
  UPDATE
  SYSTEM
  ANNOUNCEMENT
}

enum AuditAction {
  LOGIN
  PROGRAM_CREATED
  PROGRAM_UPDATED
  ASSESSMENT_PUBLISHED
  CREDENTIAL_ISSUED
  ROLE_CHANGED
}

enum ExamStatus {
  ACTIVE
  SUBMITTED
  TERMINATED
}

enum CredentialType {
  PROGRAM
  ASSESSMENT
  MERIT
}
